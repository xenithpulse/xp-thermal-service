{
  "server": {
    "host": "127.0.0.1",
    "port": 9100,
    "enableHttps": false
  },
  "security": {
    "allowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000"
    ],
    "allowedHosts": [
      "localhost",
      "127.0.0.1"
    ],
    "rateLimitPerMinute": 120,
    "enableApiKey": true,
    "maxPayloadSize": 1048576
  },
  "queue": {
    "maxConcurrentJobs": 3,
    "maxQueueDepth": 2000,
    "maxRetries": 10,
    "retryDelayMs": 1000,
    "retryBackoffMultiplier": 2,
    "maxRetryDelayMs": 60000,
    "jobTimeoutMs": 30000,
    "cleanupIntervalMs": 3600000,
    "maxJobAgeMs": 604800000,
    "persistPath": "./data/jobs.db"
  },
  "logging": {
    "level": "info",
    "file": "./logs/service.log",
    "console": true
  },
  "alerts": {
    "enabled": false,
    "webhookUrl": "",
    "pollIntervalMs": 60000,
    "confirmSamples": 2,
    "minIntervalMs": 900000
  },
  "backup": {
    "enabled": true,
    "posBaseUrl": "http://127.0.0.1:8080",
    "pollIntervalMs": 30000,
    "timeoutMs": 300000,
    "filenamePrefix": "pos-backup",
    "mongo": {
      "binDir": "C:\\Program Files\\XP POS\\mongodb\\bin",
      "host": "127.0.0.1",
      "port": 27017,
      "database": "POS_PROD",
      "gzip": true
    }
  },
  "printers": []
}
